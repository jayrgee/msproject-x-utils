{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "maven: compile project-report",
            "type": "shell",
            "command": "mvn",
            "args": [
                "-f",
                "${workspaceFolder}/mpxj/pom.xml",
                "compile"
            ],
            "group": "build",
            "problemMatcher": {
                "owner": "java",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^\\[ERROR\\] (.*):\\[([0-9]+),([0-9]+)\\] (.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "Debug VBScript (CScript)",
            "type": "shell",
            "command": "cscript.exe",
            "args": [
                "//x",
                "//d",
                "${file}",
                "${input:mppPath}"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
    {
      "id": "mppPath",
      "type": "promptString",
      "description": "Enter the MPP path:"
    }
  ]
}