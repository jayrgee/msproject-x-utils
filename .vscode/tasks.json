{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "maven: compile project-report",
            "type": "shell",
            "command": "mvn",
            "args": [
                "-f",
                "${workspaceFolder}/java/pom.xml",
                "compile"
            ],
            "group": "build",
            "problemMatcher": "$maven"
        },
        {
            "label": "Debug VBScript (CScript)",
            "type": "shell",
            "command": "cscript.exe",
            "args": [
                "//x",
                "//d",
                "${file}",
                "${input:mppPath}"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
    {
      "id": "mppPath",
      "type": "promptString",
      "description": "Enter the MPP path:"
    }
  ]
}